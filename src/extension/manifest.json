{
  "manifest_version": 3,
  "name": "CommitGuard",
  "version": "1.0.0",
  "description": "Shows the real cost of No-Cost EMI, pay-later and card payments on Amazon, Flipkart, MakeMyTrip and Udemy before you pay.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "CommitGuard",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.amazon.in/*", "*://*.flipkart.com/*", "*://*.makemytrip.com/*", "*://*.udemy.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
